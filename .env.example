# ── Required ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://abdullahfaisal.com

# ── Contact form (Resend) ──────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO_EMAIL=faisal473345@gmail.com
CONTACT_FROM_EMAIL=website@abdullahfaisal.com   # must be on a domain verified in Resend

# ── Content source ─────────────────────────────────────────
# "local" (default) reads src/content/local — the site builds with no Notion setup.
# "notion" switches to the Notion adapter. Same interface, no code changes.
CONTENT_SOURCE=local

# Only needed when CONTENT_SOURCE=notion — see NOTION-SETUP.md
NOTION_TOKEN=
NOTION_INSIGHTS_DS=
NOTION_PROJECTS_DS=

# ── On-demand revalidation ─────────────────────────────────
REVALIDATE_SECRET=change-me-to-a-long-random-string
