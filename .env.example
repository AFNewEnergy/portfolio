# ── Required ───────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://afnewenergy.com

# ── Contact form (Resend) ──────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
CONTACT_TO_EMAIL=faisal473345@gmail.com
# CONTACT_FROM_EMAIL must be on a domain verified in Resend
CONTACT_FROM_EMAIL=website@afnewenergy.com

# ── Insights from Notion — see NOTION-SETUP.md ─────────────
# With a token, Insights come from the Notion database "Insights" (created by
# /api/notion/setup). Without one, the sample articles in src/content/samples.
NOTION_TOKEN=
# Optional: pin the data source instead of finding it by name
NOTION_INSIGHTS_DS=
# Optional: INSIGHTS_SOURCE=local forces the samples even with a token
INSIGHTS_SOURCE=

# ── Projects source ────────────────────────────────────────
# "local" (default) reads src/content/local/projects.ts.
# "notion" also reads projects from Notion (needs NOTION_PROJECTS_DS).
CONTENT_SOURCE=local
NOTION_PROJECTS_DS=

# ── On-demand refresh + the one-time Notion setup link ─────
REVALIDATE_SECRET=change-me-to-a-long-random-string
